#!/usr/bin/env bash
set -euo pipefail

APP_NAME="airpods-hires-mic"
CONFIG_DIR="${HOME}/.config/${APP_NAME}"
ENV_FILE="${CONFIG_DIR}/environment"

usage() {
    cat <<'EOF'
Usage:
  airpods-hires-mic-remove --keep-config
  airpods-hires-mic-remove --purge
EOF
}

if ((EUID == 0)); then
    echo "Run this helper as the desktop user, not with sudo." >&2
    exit 1
fi

case "${1:-}" in
    --keep-config)
        [[ $# -eq 1 ]] || { usage >&2; exit 1; }
        systemctl --user stop "${APP_NAME}.service" 2>/dev/null || true
        exec sudo apt-get remove "${APP_NAME}"
        ;;
    --purge)
        [[ $# -eq 1 ]] || { usage >&2; exit 1; }
        systemctl --user stop "${APP_NAME}.service" 2>/dev/null || true
        sudo apt-get purge "${APP_NAME}"
        if [[ -f "${ENV_FILE}" && ! -L "${ENV_FILE}" ]]; then
            rm -f -- "${ENV_FILE}"
        elif [[ -e "${ENV_FILE}" || -L "${ENV_FILE}" ]]; then
            echo "Refusing to remove unsafe environment path: ${ENV_FILE}" >&2
            exit 1
        fi
        rmdir -- "${CONFIG_DIR}" 2>/dev/null || true
        echo "Purged ${APP_NAME} and this user's production settings."
        ;;
    --help|-h|"")
        usage
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
