[Unit]
Description=AirPods high-resolution virtual microphone (development)
After=pipewire-pulse.service
ConditionPathExists=%h/.config/airpods-hires-mic/dev.environment

[Service]
Type=simple
EnvironmentFile=%h/.config/airpods-hires-mic/dev.environment
ExecCondition=/usr/bin/test -n "${AIRPODS_DEVICE}"
ExecStart=/usr/bin/env ${AIRPODS_HIRES_MIC_DEV_BIN} --device ${AIRPODS_DEVICE}
Restart=no
TimeoutStopSec=10s

[Install]
WantedBy=default.target
