[Unit]
Description=AirPods high-resolution virtual microphone
After=pipewire-pulse.service

[Service]
Type=simple
EnvironmentFile=%h/.config/airpods-hires-mic/environment
ExecStart=%h/.local/bin/airpods-hires-mic --device ${AIRPODS_DEVICE}
Restart=on-failure
RestartSec=10s
TimeoutStopSec=10s

[Install]
WantedBy=default.target
